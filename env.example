# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)

# --- จำเป็น ---
SECRET_KEY=change-me-to-a-long-random-string
# รหัสเข้า /admin/login ถ้าไม่ตั้ง ระบบจะปิด admin login อัตโนมัติ
ADMIN_CODE=

# --- โหมดการทำงาน ---
FLASK_ENV=development            # ตั้งเป็น production เมื่อ deploy
ENABLE_QUICK_LOGIN=0             # 1 = เปิดปุ่มล็อกอินลัด (ใช้ตอนสาธิตเท่านั้น)
SMS_PROVIDER=console             # console (พิมพ์ OTP ใน log) หรือ twilio
IDENTITY_PROVIDER=mock           # mock = จำลองการยืนยันตัวตน

# --- ฐานข้อมูล / เซสชัน (ไม่บังคับ) ---
# DATABASE_URL=sqlite:///instance/dev.db   # ไม่ตั้ง = ใช้ instance/dev.db
SESSION_COOKIE_SECURE=0          # ตั้งเป็น 1 เมื่อใช้ HTTPS
# MAX_CONTENT_LENGTH=4194304     # ขนาดอัปโหลดสูงสุด (ไบต์)

# --- หน้าตา (ไม่บังคับ) ---
# APP_NAME=Smart Hawker
# DEFAULT_THEME=light
# DEFAULT_LANG=th
# PORT=5000

# --- ถ้าใช้ SMS_PROVIDER=twilio ให้ดูชื่อตัวแปรใน sms.py แล้วเติมที่นี่ ---
